{
  "expo": {
    "name": "Pocket",
    "slug": "pocket-penny-journal",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./public/icons/icon-512.png",
    "scheme": "pocket",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./public/icons/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F0E3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pocket.pennyjournal",
      "buildNumber": "2"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-512.png",
        "backgroundColor": "#F7F0E3"
      },
      "package": "com.pocket.pennyjournal"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2d58d71f-d419-4e6e-9d5e-efb68188b1b0"
      }
    }
  }
}
