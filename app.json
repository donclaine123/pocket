{
  "expo": {
    "name": "Pocket",
    "slug": "pocket-penny-journal",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./public/icons/icon-512.png",
    "scheme": "pocket",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./public/icons/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F0E3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pocket.pennyjournal",
      "buildNumber": "3"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-512.png",
        "backgroundColor": "#F7F0E3"
      },
      "package": "com.pocket.pennyjournal",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon.png"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/2d58d71f-d419-4e6e-9d5e-efb68188b1b0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickAdd1x1",
              "label": "Pocket Quick Entry (1x1)",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "Quick 1-tap entry into Pocket"
            },
            {
              "name": "Balance2x1",
              "label": "Pocket Balance (2x1)",
              "minWidth": "120dp",
              "minHeight": "60dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Today's spend & total balance"
            },
            {
              "name": "Glance2x2",
              "label": "Pocket Journal (2x2)",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Today's spend, recent entries, and quick log buttons"
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2d58d71f-d419-4e6e-9d5e-efb68188b1b0"
      }
    }
  }
}
